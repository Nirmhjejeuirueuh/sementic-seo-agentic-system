# Copy this file to .env and fill in your values.
#   PowerShell:  Copy-Item .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------
# NEO4J
# ---------------------------------------------------------------------
# Must match NEO4J_AUTH in docker-compose.yml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123


# ---------------------------------------------------------------------
# EMBEDDINGS
# ---------------------------------------------------------------------
# fastembed = free, local, no API key, 384 dimensions.
# openai    = paid, better quality, 1536 dimensions.
#
# To switch to openai later:
#   1. set EMBEDDING_PROVIDER=openai and EMBEDDING_DIM=1536
#   2. uncomment `openai` in requirements.txt and pip install
#   3. DROP INDEX chunk_embedding_idx; DROP INDEX keyword_embedding_idx;
#   4. python -m src.db --init-schema
#   5. re-run the ingest steps so embeddings are regenerated
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=


# ---------------------------------------------------------------------
# ANTHROPIC -- entity extraction (src/ingest/documents.py, not yet run)
# ---------------------------------------------------------------------
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

EXTRACTION_MODEL=claude-sonnet-5
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001


# ---------------------------------------------------------------------
# THE PAGE-WRITING AGENT (Phase 7) -- src/agents/page_graph.py
# ---------------------------------------------------------------------
# Which provider the agent uses. Must be one of: anthropic, openai, gemini.
# Only that provider's key below needs to be filled in.
AGENT_PROVIDER=anthropic

# AGENT_MODEL is optional -- if blank, a sensible default is chosen per
# provider (see _AGENT_MODEL_DEFAULTS in src/config.py).
AGENT_MODEL=

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
